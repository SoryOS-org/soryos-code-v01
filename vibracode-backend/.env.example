# =============================================================================
# Vibra Code Backend - Environment Variables
# Copy this file to .env.local and fill in the values
# =============================================================================

# --- Agent Configuration ---
# Which engine executes messages:
#   provider (default) - native backend engine: the server calls OpenRouter /
#                        Mistral / Gemini directly and runs tools in the E2B
#                        sandbox (lib/providers). No CLI is installed in the
#                        sandbox. Cursor always keeps the CLI engine.
#   cli                - legacy engine: Claude Code / Gemini / Cursor CLIs run
#                        inside the sandbox (rollback)
AGENT_ENGINE=provider
# Legacy agent type still honoured by the CLI engine and model routing:
#   claude, cursor, gemini
AGENT_TYPE=claude

# --- OpenRouter (native provider, default) ---
# Required: one key exposes every OpenRouter free model
# Create a free key at https://openrouter.ai/keys (models ending in :free cost nothing)
OPENROUTER_API_KEY=
# OpenAI-compatible chat completions endpoint (used by the native engine)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional overrides (mostly for dedicated deployments)
OPENROUTER_DEFAULT_MODEL=openrouter/free
# Optional attribution headers sent with every request
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# --- Mistral AI (official API) ---
# Create a free/beta key at https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_DEFAULT_MODEL=mistral-large-latest

# --- Google AI Studio (Gemini official API) ---
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# --- Cursor Agent (optional, legacy CLI engine only) ---
# Required only if AGENT_TYPE=cursor
CURSOR_AGENT_API_KEY=

# --- OpenAI (optional - image generation) ---
OPENAI_API_KEY=
OPENAI_PROXY_URL=https://api.openai.com

# --- ElevenLabs (optional - audio generation) ---
ELEVENLABS_API_KEY=
ELEVENLABS_PROXY_URL=https://api.elevenlabs.io

# --- Context7 MCP (optional - documentation lookup) ---
CONTEXT7_API_KEY=

# --- E2B Sandbox ---
# Required - cloud sandbox for code execution
# Sign up at https://e2b.dev
E2B_API_KEY=
# Auto-pause sandbox after inactivity (milliseconds, default: 10 minutes)
AUTO_PAUSE_TIMEOUT_MS=600000

# --- Convex Real-time Database ---
# Required - sign up at https://convex.dev
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# OAuth (optional - for Convex auth integration)
CONVEX_OAUTH_CLIENT_ID=
CONVEX_OAUTH_CLIENT_SECRET=
NEXT_PUBLIC_CONVEX_OAUTH_CLIENT_ID=

# --- Clerk Authentication ---
# Required - sign up at https://clerk.com
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- NextAuth (optional - web auth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- GitHub OAuth (optional - push to GitHub feature) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe Payments (optional - web subscriptions) ---
# Only needed if you want web payment processing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_WEEKLY_PLUS=

# --- RevenueCat (optional - mobile in-app purchases) ---
# Only needed if you want mobile subscription support
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_OAUTH_CLIENT_ID=
REVENUECAT_OAUTH_CLIENT_SECRET=
REVENUECAT_OAUTH_REDIRECT_URI=

# --- Northflank (optional - alternative sandbox provider) ---
NORTHFLANK_API_KEY=
NORTHFLANK_PROJECT_ID=your-project-id
SANDBOX_PROVIDER=northflank

# --- Featurebase (optional - feature request tracking) ---
FEATUREBASE_SECRET_KEY=

# --- Firecrawl (optional - web scraping) ---
FIRECRAWL_API_KEY=

# --- App Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Set to true when running Inngest dev server locally
# Start Inngest dev server with: npx inngest-cli@latest dev (runs on port 8288)
# Dashboard available at: http://localhost:8288
INNGEST_DEV=true

# --- Push Notifications (optional) ---
ADMIN_SECRET=
